<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CloudVault" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/accent_blue</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent_cyan_bright</item>
        <item name="colorSecondaryVariant">@color/accent_cyan</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="alertDialogTheme">@style/Theme.CloudVault.Dialog.Alert</item>
        <item name="materialAlertDialogTheme">@style/Theme.CloudVault.Dialog.Alert</item>
    </style>

    <style name="Theme.CloudVault.Dialog.Alert" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">@color/card_bg</item>
        <item name="backgroundTint">@color/card_bg</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CloudVault.Dialog</item>
        <item name="colorPrimary">@color/accent_cyan_bright</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.CloudVault.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.CloudVault.Dialog.Button.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.CloudVault.Dialog.Button.Neutral</item>
    </style>

    <style name="ShapeAppearance.CloudVault.Dialog" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.CloudVault.Dialog.Button.Positive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_cyan_bright</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.CloudVault.Dialog.Button.Negative" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.CloudVault.Dialog.Button.Neutral" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_blue_light</item>
    </style>

    <!-- Fullscreen Dialog Theme for modals -->
    <style name="Theme.CloudVault.Dialog.Fullscreen" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- AMOLED Pure Black Theme -->
    <style name="Theme.CloudVault.Amoled" parent="Theme.CloudVault">
        <item name="android:statusBarColor">@color/bg_amoled</item>
        <item name="android:navigationBarColor">@color/bg_amoled</item>
        <item name="android:windowBackground">@color/bg_amoled</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Light Theme Explicit -->
    <style name="Theme.CloudVault.Light" parent="Theme.CloudVault">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Midnight Purple Theme -->
    <style name="Theme.CloudVault.MidnightPurple" parent="Theme.CloudVault">
        <item name="colorPrimary">#A855F7</item>
        <item name="colorPrimaryVariant">#9333EA</item>
        <item name="colorSecondary">#C084FC</item>
        <item name="android:statusBarColor">#0B0819</item>
        <item name="android:navigationBarColor">#0B0819</item>
        <item name="android:windowBackground">#0B0819</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Emerald Forest Theme -->
    <style name="Theme.CloudVault.EmeraldNord" parent="Theme.CloudVault">
        <item name="colorPrimary">#10B981</item>
        <item name="colorPrimaryVariant">#059669</item>
        <item name="colorSecondary">#34D399</item>
        <item name="android:statusBarColor">#061811</item>
        <item name="android:navigationBarColor">#061811</item>
        <item name="android:windowBackground">#061811</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Sunset Amber Theme -->
    <style name="Theme.CloudVault.SunsetAmber" parent="Theme.CloudVault">
        <item name="colorPrimary">#F59E0B</item>
        <item name="colorPrimaryVariant">#D97706</item>
        <item name="colorSecondary">#FBBF24</item>
        <item name="android:statusBarColor">#181109</item>
        <item name="android:navigationBarColor">#181109</item>
        <item name="android:windowBackground">#181109</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Crimson Rose Theme -->
    <style name="Theme.CloudVault.CrimsonRose" parent="Theme.CloudVault">
        <item name="colorPrimary">#F43F5E</item>
        <item name="colorPrimaryVariant">#E11D48</item>
        <item name="colorSecondary">#FB7185</item>
        <item name="android:statusBarColor">#18080C</item>
        <item name="android:navigationBarColor">#18080C</item>
        <item name="android:windowBackground">#18080C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Ocean Sapphire Theme -->
    <style name="Theme.CloudVault.OceanSapphire" parent="Theme.CloudVault">
        <item name="colorPrimary">#2563EB</item>
        <item name="colorPrimaryVariant">#1D4ED8</item>
        <item name="colorSecondary">#60A5FA</item>
        <item name="android:statusBarColor">#0A1128</item>
        <item name="android:navigationBarColor">#0A1128</item>
        <item name="android:windowBackground">#0A1128</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
