<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0A0F1D"
    android:padding="18dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Logs &amp; Diagnostics"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLogsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Live system and network activity"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCloseLogs"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#94A3B8"
            android:textSize="18sp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Search / Filter Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0F172A"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etLogSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:hint="Filter logs (e.g. upload, error, tdlib, stream)..."
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="13sp"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:id="@+id/btnClearFilter"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Action Buttons Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyLogs"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="📋 Copy All"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            app:backgroundTint="#16263D"
            app:strokeColor="#0284C7"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefreshLogs"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="🔄 Refresh"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            app:backgroundTint="#1E293B"
            app:strokeColor="#334155"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearLogs"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="🗑️ Clear"
            android:textColor="#EF4444"
            android:textSize="11sp"
            app:backgroundTint="#1F1318"
            app:strokeColor="#7F1D1D"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <!-- Terminal-styled Scrollable Log Output -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_marginTop="12dp"
        android:background="#050811"
        android:padding="10dp">

        <ScrollView
            android:id="@+id/scrollLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:fadeScrollbars="false">

            <TextView
                android:id="@+id/tvLogsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Loading logs..."
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:textIsSelectable="true" />
        </ScrollView>

        <TextView
            android:id="@+id/tvEmptyLogs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="No diagnostic logs recorded yet."
            android:textColor="#64748B"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDismissLogs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:text="Done"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:backgroundTint="#1E293B"
        app:cornerRadius="10dp" />

</LinearLayout>
