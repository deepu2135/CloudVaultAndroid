<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="18dp"
    android:paddingBottom="8dp"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tvDateHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Date Group"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Selection Check Circle Container for Date Section -->
    <FrameLayout
        android:id="@+id/layoutDateSelectionCheck"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:visibility="gone">

        <!-- Unselected Ring -->
        <View
            android:id="@+id/viewDateCheckUnselected"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_selection_circle_unselected" />

        <!-- Selected Blue Circle with Checkmark -->
        <FrameLayout
            android:id="@+id/viewDateCheckSelected"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_selection_circle_selected"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>

</LinearLayout>
