<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Top Close Handle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnCloseAudioPlayer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="▼"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="NOW PLAYING"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/btnAudioQueue"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="≡"
                android:textColor="@color/text_secondary"
                android:textSize="22sp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Big Album Artwork Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/bg_surface_elevated"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tvAudioArtEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🎵"
                    android:textSize="80sp" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Track Title & Subtitle -->
        <TextView
            android:id="@+id/tvFullAudioTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="Track Title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/tvFullAudioSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="CloudVault Audio Stream"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- SeekBar & Timers -->
        <SeekBar
            android:id="@+id/sbAudioProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:max="1000"
            android:progressTint="@color/accent_cyan"
            android:thumbTint="@color/accent_cyan_bright" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAudioCurrentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAudioTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Playback Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical|center_horizontal">

            <!-- Shuffle Button -->
            <TextView
                android:id="@+id/btnAudioShuffle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="🔀"
                android:textSize="18sp"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- Prev Button -->
            <TextView
                android:id="@+id/btnAudioPrevTrack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:text="⏮"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- Play/Pause Big Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAudioPlayPause"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="34dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/accent_cyan"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvAudioPlayPauseIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="▶"
                    android:textColor="#000000"
                    android:textSize="26sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Next Button -->
            <TextView
                android:id="@+id/btnAudioNextTrack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:text="⏭"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- Repeat Button -->
            <TextView
                android:id="@+id/btnAudioRepeat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="🔁"
                android:textSize="18sp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
