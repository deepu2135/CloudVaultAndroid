<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/bg_surface">

        <TextView
            android:id="@+id/tvDocIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📄"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDocTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Document Title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/tvDocSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="PDF • 2.4 MB"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Search Button -->
        <TextView
            android:id="@+id/btnDocSearch"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="🔍"
            android:textSize="16sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- Wrap Toggle Button (Code/Text) -->
        <TextView
            android:id="@+id/btnDocWrap"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="↩"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- Copy All Button -->
        <TextView
            android:id="@+id/btnDocCopy"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="📋"
            android:textSize="16sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- Download Button -->
        <TextView
            android:id="@+id/btnDocDownload"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="⬇"
            android:textColor="@color/accent_cyan_bright"
            android:textSize="18sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- Close Button -->
        <TextView
            android:id="@+id/btnDocClose"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Expandable Search Bar -->
    <LinearLayout
        android:id="@+id/layoutDocSearchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/bg_surface_elevated"
        android:visibility="gone">

        <EditText
            android:id="@+id/etDocSearchInput"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:hint="Search in document..."
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <TextView
            android:id="@+id/tvDocSearchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="0/0"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnDocSearchPrev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="▲"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/btnDocSearchNext"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="▼"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/btnDocSearchClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. PDF Page Rendering Container -->
        <FrameLayout
            android:id="@+id/layoutPdfContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivPdfPage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter" />
                </HorizontalScrollView>
            </ScrollView>

            <!-- PDF Page Navigation Bar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPdfNavigation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/btnPdfPrevPage"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="◀"
                        android:textColor="@color/accent_cyan_bright"
                        android:textSize="14sp"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/tvPdfPageIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="Page 1 / 1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnPdfNextPage"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="▶"
                        android:textColor="@color/accent_cyan_bright"
                        android:textSize="14sp"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- 2. Code & Text File Viewer Container -->
        <ScrollView
            android:id="@+id/layoutCodeContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <HorizontalScrollView
                android:id="@+id/hsvCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <!-- Line Numbers Gutter -->
                    <TextView
                        android:id="@+id/tvLineNumbers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="1\n2\n3"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:lineSpacingExtra="4dp" />

                    <!-- Code / Text Content -->
                    <TextView
                        android:id="@+id/tvCodeContent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text=""
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="4dp"
                        android:textIsSelectable="true" />
                </LinearLayout>
            </HorizontalScrollView>
        </ScrollView>

        <!-- 3. Web / Markdown / EPUB View -->
        <WebView
            android:id="@+id/wvDocWeb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 4. Loading State View -->
        <LinearLayout
            android:id="@+id/layoutDocLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <ProgressBar
                android:id="@+id/pbDocLoading"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/accent_cyan" />

            <TextView
                android:id="@+id/tvDocLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Loading document from Telegram Cloud..."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
