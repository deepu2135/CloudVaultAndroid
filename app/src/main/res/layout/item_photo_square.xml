<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp"
    android:background="#080E18">

    <!-- 1:1 Aspect Ratio Square Tile -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Photo Thumbnail"
            android:scaleType="centerCrop" />

        <!-- Placeholder Icon -->
        <TextView
            android:id="@+id/tvPlaceholderIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="📷"
            android:textSize="22sp" />

        <!-- Loading Spinner -->
        <ProgressBar
            android:id="@+id/pbThumbLoading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent_cyan"
            android:visibility="gone" />

        <!-- Selection Overlay Dimmer -->
        <View
            android:id="@+id/selectionDimOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#4D2563EB"
            android:visibility="gone" />

        <!-- Selection Check Circle Container -->
        <FrameLayout
            android:id="@+id/layoutSelectionCheck"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:visibility="gone">

            <!-- Unselected Ring -->
            <View
                android:id="@+id/viewCheckUnselected"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_selection_circle_unselected" />

            <!-- Selected Blue Circle with Checkmark -->
            <FrameLayout
                android:id="@+id/viewCheckSelected"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_selection_circle_selected"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
